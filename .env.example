# Copy the keys you need into .env (never commit .env)
ULTRAHUMAN_TOKEN=

# Exact room location (decimal degrees) so outdoor data matches the sensor
HOME_LAT=51.4988
HOME_LON=-0.1749

# http (ESP32 over WiFi, preferred) | serial (USB) | adafruit (Pi + I2C) | sim (no hardware)
SCD40_BACKEND=http
# Shared secret the ESP32 sends in X-Auth-Token (any long random string; also put it in the firmware)
INGEST_TOKEN=
INGEST_PORT=8765
SCD40_SERIAL_PORT=COM3
SCD40_TEMP_OFFSET_C=4.0

# --- watchdog alerts (see scripts/README-watchdog.md) -----------------------
# ntfy: pick a long random topic, subscribe to it in the ntfy phone app.
SIOT_NTFY_TOPIC=
SIOT_NTFY_URL=https://ntfy.sh
# Daily "all well" push at this hour (0-23) so silence means the watchdog died.
SIOT_HEARTBEAT_HOUR=9
# Optional email route; use an app password, never an account password.
SIOT_MAIL_TO=
SIOT_MAIL_FROM=
SIOT_MAIL_HOST=smtp.gmail.com
SIOT_MAIL_PORT=587
SIOT_MAIL_PASS=
